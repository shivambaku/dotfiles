* {
	font-family: "MesloLGS Nerd Font";
	font-size: 14px;
	color: #cdd6f4;
}

QMainWindow,
QMainWindow > QWidget,
QTabWidget::pane,
QScrollArea,
QScrollArea > QWidget > QWidget {
	background-color: #0a0c10;
}

QTabWidget::pane {
	border: 1px solid #303341;
	border-radius: 5px;
	top: -1px;
}

QTabBar::tab {
	background-color: transparent;
	color: #a6adc8;
	border: none;
	border-bottom: 2px solid transparent;
	padding: 10px 18px;
	margin-right: 4px;
}

QTabBar::tab:hover {
	color: #cdd6f4;
	background-color: #13151d;
}

QTabBar::tab:selected {
	color: #89b4fa;
	border-bottom-color: #89b4fa;
}

QScrollArea {
	border: none;
}

QPushButton {
	background-color: #1b1d27;
	color: #cdd6f4;
	border: 1px solid #303341;
	border-radius: 5px;
	padding: 10px 14px;
}

QPushButton:hover,
QPushButton:focus {
	background-color: #252836;
	border-color: #89b4fa;
}

QPushButton:pressed {
	background-color: #89b4fa;
	color: #0a0c10;
}

QCheckBox {
	color: #a6adc8;
	spacing: 8px;
	padding: 8px 2px 2px 2px;
}

QCheckBox:hover,
QCheckBox:focus {
	color: #cdd6f4;
}

QScrollBar:vertical {
	background-color: transparent;
	width: 8px;
	margin: 2px;
}

QScrollBar::handle:vertical {
	background-color: #45475a;
	border-radius: 4px;
	min-height: 30px;
}

QScrollBar::handle:vertical:hover {
	background-color: #585b70;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
	background: none;
	height: 0;
}

QToolTip {
	background-color: #1b1d27;
	color: #cdd6f4;
	border: 1px solid #303341;
	padding: 6px;
}
