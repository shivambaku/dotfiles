[Desktop Entry]
Type=Application
Version=1.0
Name=SB - System Report
GenericName=System Diagnostics
Comment=Review recent warnings, crashes, and system health
Icon=utilities-terminal
Exec=wezterm start --always-new-process -- report-system
TryExec=wezterm
Terminal=false
Categories=System;ConsoleOnly;
Keywords=SB;System;Report;Logs;Journal;Errors;Warnings;Crashes;Kernel;
