[Desktop Entry]
Type=Application
Version=1.0
Name=SB - System Update
GenericName=Software Update
Comment=Update system packages and Flatpaks
Icon=utilities-terminal
Exec=wezterm start --always-new-process -- auto-launcher-terminal update-system
Terminal=false
Categories=System;
Keywords=SB;Script;Update;Packages;Pacman;Paru;Flatpak;Firmware;
