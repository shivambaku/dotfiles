#!/usr/bin/env bash
set -euo pipefail

readonly AUTOSWITCH_SETTING='bluetooth.autoswitch-to-headset-profile'
readonly METADATA_LINE_PATTERN="^update:[[:space:]]+id:[0-9]+[[:space:]]+key:'([^']+)'[[:space:]]+value:'([^']*)'"
readonly ROUTE_PROFILE_PATTERN='^(bluez_card\.[^:]+):profile:([^=]+)='
readonly WIREPLUMBER_STATE_DIR="${WIREPLUMBER_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/wireplumber}"

card=''
card_description=''
card_error=''
cards_json='[]'
active_profile=''
target_profile=''
saved_card=''
saved_error=''
declare -a profile_names=()
declare -a saved_cards=()
declare -a known_profile_names=()
declare -A profile_sinks=()
declare -A profile_sources=()
declare -A profile_priorities=()
declare -A profile_available=()
declare -A saved_profiles=()
declare -A known_profile_seen=()

die() {
  printf 'pick-bluetooth-profile: %s\n' "$*" >&2
  exit 1
}

usage() {
  printf '%s\n' \
    'Usage: pick-bluetooth-profile [status [--short]|music|call|toggle|automatic]' \
    '' \
    'Run without arguments to open the interactive picker.' \
    'Automatic lets WirePlumber switch profiles when the microphone is used.' \
    'Music uses a high-quality output profile without the headset microphone.' \
    'Call uses a duplex profile with the headset microphone enabled.'
}

require_commands() {
  local command

  for command in jq pactl pw-metadata wpctl; do
    command -v "$command" >/dev/null || die "required command not found: $command"
  done
}

load_cards() {
  local output

  output=$(LC_ALL=C pactl --format=json list cards) || return 1
  jq -s -e 'length == 1 and (.[0] | type == "array")' <<< "$output" >/dev/null 2>&1 || return 1
  cards_json=$output
}

find_active_card() {
  local default_sink default_source candidate token source_token
  local -a cards=()

  card=''
  card_error=''
  load_cards || die 'could not list audio cards'
  mapfile -t cards < <(
    jq -r '.[] | .name? | select(type == "string" and startswith("bluez_card."))' <<< "$cards_json"
  )

  if ((${#cards[@]} == 0)); then
    card_error='no connected Bluetooth audio device'
    return 1
  fi

  default_sink=$(LC_ALL=C pactl get-default-sink 2>/dev/null || true)
  for candidate in "${cards[@]}"; do
    token=${candidate#bluez_card.}
    if [[ $default_sink == "bluez_output.$token"* ]]; then
      card=$candidate
      return
    fi
  done

  default_source=$(LC_ALL=C pactl get-default-source 2>/dev/null || true)
  for candidate in "${cards[@]}"; do
    token=${candidate#bluez_card.}
    source_token=${token//_/:}
    if [[ $default_source == "bluez_input.$token"* || $default_source == "bluez_input.$source_token"* ]]; then
      card=$candidate
      return
    fi
  done

  if ((${#cards[@]} == 1)); then
    card=${cards[0]}
    return
  fi

  card_error='multiple Bluetooth audio devices are connected, but none is the default'
  return 1
}

load_card_details() {
  local card_json profiles name sinks sources priority available

  card_description=''
  active_profile=''
  profile_names=()
  profile_sinks=()
  profile_sources=()
  profile_priorities=()
  profile_available=()

  load_cards || return 1
  card_json=$(jq -ce --arg card "$card" '
    [.[] | select(.name? == $card)]
    | if length == 1 and (.[0].profiles | type) == "object" then .[0] else empty end
  ' <<< "$cards_json") || return 1
  active_profile=$(jq -er '.active_profile | select(type == "string" and length > 0)' <<< "$card_json") || return 1
  card_description=$(jq -r '
    (.properties["device.description"]? // .name)
    | if type == "string" and length > 0 then . else "" end
  ' <<< "$card_json")
  [[ -n $card_description ]] || card_description=$card

  profiles=$(jq -er '
    def number_or_zero:
      if . == null then 0
      elif type == "number" and . >= 0 and floor == . then .
      else error("expected a non-negative integer")
      end;
    .profiles
    | to_entries
    | if length == 0 then error("card has no profiles") else . end
    | .[]
    | [
        .key,
        (.value.sinks | number_or_zero),
        (.value.sources | number_or_zero),
        (.value.priority | number_or_zero),
        (if .value.available == false then "no" elif .value.available == true then "yes" elif .value.available == null then "unknown" else error("expected availability to be boolean or null") end)
      ]
    | @tsv
  ' <<< "$card_json") || return 1

  while IFS=$'\t' read -r name sinks sources priority available; do
    profile_names+=("$name")
    profile_sinks["$name"]=$sinks
    profile_sources["$name"]=$sources
    profile_priorities["$name"]=$priority
    profile_available["$name"]=$available
  done <<< "$profiles"
}

load_saved_profiles() {
  local output line key value

  saved_cards=()
  saved_profiles=()
  output=$(LC_ALL=C pw-metadata -n default-profile 2>/dev/null) || return 1

  while IFS= read -r line; do
    if [[ $line =~ $METADATA_LINE_PATTERN ]]; then
      key=${BASH_REMATCH[1]}
      value=${BASH_REMATCH[2]}
      if [[ $key == bluez_card.* ]]; then
        saved_cards+=("$key")
        saved_profiles["$key"]=$value
      fi
    fi
  done <<< "$output"
}

find_saved_card() {
  saved_card=''
  saved_error=''

  if ! load_saved_profiles; then
    saved_error='could not read WirePlumber saved profiles'
    return 1
  fi

  case ${#saved_cards[@]} in
    0)
      saved_error='no previously connected Bluetooth audio device is saved; connect it once first'
      return 1
      ;;
    1)
      saved_card=${saved_cards[0]}
      ;;
    *)
      saved_error='multiple Bluetooth audio devices are saved; connect the headset you want to change'
      return 1
      ;;
  esac
}

load_known_profiles() {
  local target_card=$1 line route_card name saved

  known_profile_names=()
  known_profile_seen=()

  if [[ -r $WIREPLUMBER_STATE_DIR/default-routes ]]; then
    while IFS= read -r line; do
      if [[ $line =~ $ROUTE_PROFILE_PATTERN ]]; then
        route_card=${BASH_REMATCH[1]}
        name=${BASH_REMATCH[2]}
        if [[ $route_card == "$target_card" && -z ${known_profile_seen[$name]+x} ]]; then
          known_profile_names+=("$name")
          known_profile_seen["$name"]=1
        fi
      fi
    done < "$WIREPLUMBER_STATE_DIR/default-routes"
  fi

  saved=${saved_profiles[$target_card]:-}
  if [[ -n $saved && -z ${known_profile_seen[$saved]+x} ]]; then
    known_profile_names+=("$saved")
    known_profile_seen["$saved"]=1
  fi
}

profile_is_available() {
  [[ ${profile_available[$1]:-unknown} != 'no' ]]
}

connected_profile_mode() {
  local name=$1

  if [[ -n $name ]] && ((${profile_sinks[$name]:-0} > 0)) && ((${profile_sources[$name]:-0} > 0)); then
    printf 'call'
  elif [[ -n $name ]] && ((${profile_sinks[$name]:-0} > 0)); then
    printf 'music'
  else
    printf 'other'
  fi
}

saved_profile_mode() {
  case $1 in
    headset-head-unit*|bap-duplex|*duplex*) printf 'call' ;;
    a2dp-sink*|bap-sink*) printf 'music' ;;
    *) printf 'other' ;;
  esac
}

choose_music_profile() {
  local name score bonus best_score=-1

  target_profile=''
  for name in "${profile_names[@]}"; do
    if ! profile_is_available "$name" || ((${profile_sinks[$name]:-0} == 0)) ||
      ((${profile_sources[$name]:-0} > 0)); then
      continue
    fi

    bonus=0
    case $name in
      a2dp-sink*|bap-sink*) bonus=10 ;;
    esac
    score=$((${profile_priorities[$name]:-0} * 100 + bonus))
    if ((score > best_score)); then
      target_profile=$name
      best_score=$score
    fi
  done

  [[ -n $target_profile ]]
}

choose_call_profile() {
  local name best_priority=-1

  target_profile=''
  for name in "${profile_names[@]}"; do
    if ! profile_is_available "$name" || ((${profile_sinks[$name]:-0} == 0)) ||
      ((${profile_sources[$name]:-0} == 0)); then
      continue
    fi

    if ((${profile_priorities[$name]:-0} > best_priority)); then
      target_profile=$name
      best_priority=${profile_priorities[$name]:-0}
    fi
  done

  [[ -n $target_profile ]]
}

choose_saved_profile() {
  local mode=$1 target_card=$2 current name score best_score=-1

  target_profile=''
  load_known_profiles "$target_card"
  current=${saved_profiles[$target_card]:-}
  if [[ $(saved_profile_mode "$current") == "$mode" ]]; then
    target_profile=$current
    return
  fi

  for name in "${known_profile_names[@]}"; do
    [[ $(saved_profile_mode "$name") == "$mode" ]] || continue
    score=0
    case "$mode:$name" in
      music:a2dp-sink) score=500 ;;
      music:a2dp-sink*) score=400 ;;
      music:bap-sink*) score=300 ;;
      call:bap-duplex) score=600 ;;
      call:headset-head-unit) score=500 ;;
      call:*duplex*) score=400 ;;
      call:*msbc*) score=300 ;;
      call:*cvsd*) score=200 ;;
      call:headset-head-unit*) score=100 ;;
    esac
    if ((score > best_score)); then
      target_profile=$name
      best_score=$score
    fi
  done

  [[ -n $target_profile ]]
}

autoswitch_state() {
  local output

  output=$(wpctl settings "$AUTOSWITCH_SETTING" 2>/dev/null) || {
    printf 'unknown'
    return
  }

  if [[ $output =~ Value:[[:space:]]*(true|false) ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  else
    printf 'unknown'
  fi
}

set_autoswitch() {
  wpctl settings --save "$AUTOSWITCH_SETTING" "$1" >/dev/null
}

restore_autoswitch() {
  case $1 in
    true|false) set_autoswitch "$1" >/dev/null 2>&1 || true ;;
  esac
}

save_profile_metadata() {
  local target_card=$1 profile=$2 attempt

  LC_ALL=C pw-metadata -n default-profile 0 "$target_card" "$profile" >/dev/null || return 1
  for attempt in {1..10}; do
    if load_saved_profiles && [[ ${saved_profiles[$target_card]:-} == "$profile" ]]; then
      return
    fi
    sleep 0.1
  done
  return 1
}

mode_label() {
  case $1 in
    music) printf 'Music' ;;
    call) printf 'Call' ;;
    disconnected) printf 'Disconnected' ;;
    ambiguous) printf 'Ambiguous' ;;
    *) printf 'Other' ;;
  esac
}

format_card_address() {
  local address=${1#bluez_card.}
  printf '%s' "${address//_/:}"
}

show_status() {
  local short=${1:-false}
  local mode autoswitch saved

  if ! find_active_card; then
    [[ $card_error == no\ connected* ]] && mode='disconnected' || mode='ambiguous'
    if [[ $short == true ]]; then
      printf '%s\n' "$mode"
      return
    fi

    printf 'Device:        %s\n' "$card_error"
    printf 'Mode:          %s\n' "$(mode_label "$mode")"
    if [[ $mode == disconnected ]]; then
      if find_saved_card; then
        saved=${saved_profiles[$saved_card]}
        printf 'Saved device:  %s\n' "$(format_card_address "$saved_card")"
        printf 'Saved mode:    %s\n' "$(mode_label "$(saved_profile_mode "$saved")")"
        printf 'Saved profile: %s\n' "$saved"
      else
        printf 'Saved profile: unavailable (%s)\n' "$saved_error"
      fi
    fi
    printf 'Autoswitch:    %s\n' "$(autoswitch_state)"
    return
  fi

  load_card_details || die "could not read the active profile for $card"
  mode=$(connected_profile_mode "$active_profile")
  autoswitch=$(autoswitch_state)
  if [[ $short == true ]]; then
    printf '%s\n' "$mode"
    return
  fi

  saved='none'
  if load_saved_profiles; then
    saved=${saved_profiles[$card]:-none}
  fi
  printf 'Device:        %s\n' "$card_description"
  printf 'Mode:          %s\n' "$(mode_label "$mode")"
  printf 'Profile:       %s\n' "$active_profile"
  printf 'Saved profile: %s\n' "$saved"
  printf 'Autoswitch:    %s\n' "$autoswitch"
}

notify_connected_mode() {
  local mode=$1 label icon

  label=$(mode_label "$mode")
  [[ $mode == music ]] && icon='audio-headphones' || icon='audio-headset'
  notify-send -a 'Bluetooth Profile' -i "$icon" \
    "Bluetooth: $label" \
    "$card_description now uses $target_profile. Applications may need you to reselect the audio device." \
    >/dev/null 2>&1 || true
}

notify_saved_mode() {
  local mode=$1 label icon

  label=$(mode_label "$mode")
  [[ $mode == music ]] && icon='audio-headphones' || icon='audio-headset'
  notify-send -a 'Bluetooth Profile' -i "$icon" \
    "Bluetooth: $label saved" \
    "$target_profile will be restored the next time this headset connects." \
    >/dev/null 2>&1 || true
}

rollback_connected() {
  local previous_profile=$1 previous_saved=$2 previous_autoswitch=$3

  pactl set-card-profile "$card" "$previous_profile" >/dev/null 2>&1 || true
  if [[ -n $previous_saved ]]; then
    LC_ALL=C pw-metadata -n default-profile 0 "$card" "$previous_saved" >/dev/null 2>&1 || true
  else
    LC_ALL=C pw-metadata --delete -n default-profile 0 "$card" >/dev/null 2>&1 || true
  fi
  restore_autoswitch "$previous_autoswitch"
}

apply_connected_profile() {
  local mode=$1 previous_profile previous_saved previous_autoswitch verified=false
  local attempt

  load_card_details || die "could not read the active profile for $card"
  previous_profile=$active_profile
  previous_autoswitch=$(autoswitch_state)
  [[ $previous_autoswitch != unknown ]] || die 'could not read automatic Bluetooth profile switching state'
  load_saved_profiles || die 'could not read WirePlumber saved profiles'
  previous_saved=${saved_profiles[$card]:-}

  case $mode in
    music) choose_music_profile || die "$card_description has no available music profile" ;;
    call) choose_call_profile || die "$card_description has no available call profile with a microphone" ;;
  esac

  set_autoswitch false || die 'could not disable automatic Bluetooth profile switching'
  if ! pactl set-card-profile "$card" "$target_profile"; then
    rollback_connected "$previous_profile" "$previous_saved" "$previous_autoswitch"
    die "could not switch $card_description to $target_profile"
  fi

  for attempt in {1..10}; do
    sleep 0.2
    if load_card_details && [[ $active_profile == "$target_profile" ]]; then
      verified=true
      break
    fi
  done

  if [[ $verified != true ]]; then
    rollback_connected "$previous_profile" "$previous_saved" "$previous_autoswitch"
    die "profile change did not remain on $target_profile; previous settings were restored"
  fi

  if ! save_profile_metadata "$card" "$target_profile"; then
    rollback_connected "$previous_profile" "$previous_saved" "$previous_autoswitch"
    die "could not save $target_profile for $card_description; previous settings were restored"
  fi

  printf 'Switched and saved %s as %s (%s).\n' "$card_description" "$(mode_label "$mode")" "$target_profile"
  notify_connected_mode "$mode"
  show_status
}

apply_disconnected_profile() {
  local mode=$1 previous_profile previous_autoswitch

  find_saved_card || die "$saved_error"
  previous_profile=${saved_profiles[$saved_card]}
  previous_autoswitch=$(autoswitch_state)
  [[ $previous_autoswitch != unknown ]] || die 'could not read automatic Bluetooth profile switching state'
  if ! choose_saved_profile "$mode" "$saved_card"; then
    die "no previously observed $(mode_label "$mode") profile is available for $(format_card_address "$saved_card"); connect it once to select this mode"
  fi

  set_autoswitch false || die 'could not disable automatic Bluetooth profile switching'
  if ! save_profile_metadata "$saved_card" "$target_profile"; then
    LC_ALL=C pw-metadata -n default-profile 0 "$saved_card" "$previous_profile" >/dev/null 2>&1 || true
    restore_autoswitch "$previous_autoswitch"
    die "could not save $target_profile; previous settings were restored"
  fi

  printf 'Saved %s (%s) for Bluetooth device %s; it will apply on the next connection.\n' \
    "$(mode_label "$mode")" "$target_profile" "$(format_card_address "$saved_card")"
  notify_saved_mode "$mode"
  show_status
}

apply_profile() {
  local mode=$1

  if find_active_card; then
    apply_connected_profile "$mode"
  elif [[ $card_error == no\ connected* ]]; then
    apply_disconnected_profile "$mode"
  else
    die "$card_error"
  fi
}

enable_automatic() {
  set_autoswitch true || die 'could not enable automatic Bluetooth profile switching'
  printf 'Automatic profile switching enabled for all Bluetooth headsets.\n'
  notify-send -a 'Bluetooth Profile' -i 'audio-headset' \
    'Bluetooth: Automatic' 'WirePlumber will choose Music or Call mode for all Bluetooth headsets.' \
    >/dev/null 2>&1 || true
  show_status
}

toggle_profile() {
  local mode saved

  if find_active_card; then
    load_card_details || die "could not read the active profile for $card"
    mode=$(connected_profile_mode "$active_profile")
  elif [[ $card_error == no\ connected* ]]; then
    find_saved_card || die "$saved_error"
    saved=${saved_profiles[$saved_card]}
    mode=$(saved_profile_mode "$saved")
  else
    die "$card_error"
  fi

  case $mode in
    call) apply_profile music ;;
    music) apply_profile call ;;
    *) die 'the current or saved profile is neither Music nor Call' ;;
  esac
}

interactive_picker() {
  local choice

  show_status
  printf '\n'
  printf '%s\n' \
    '1) Automatic (switch profiles when the headset microphone is used)' \
    '2) Music     (high-quality audio, headset microphone unavailable)' \
    '3) Call      (headset microphone enabled, lower-quality audio)' \
    'q) Quit'

  while true; do
    read -r -p 'Select Bluetooth profile: ' choice || exit 0
    case $choice in
      1) enable_automatic; return ;;
      2) apply_profile music; return ;;
      3) apply_profile call; return ;;
      q|Q) return ;;
      *) printf 'Choose 1-3 or q.\n' >&2 ;;
    esac
  done
}

main() {
  local action=${1:-}

  require_commands
  case $action in
    '') interactive_picker ;;
    status)
      case ${2:-} in
        '') show_status ;;
        --short) show_status true ;;
        *) usage >&2; exit 2 ;;
      esac
      ;;
    music) apply_profile music ;;
    call) apply_profile call ;;
    toggle) toggle_profile ;;
    automatic|auto) enable_automatic ;;
    -h|--help|help) usage ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"
