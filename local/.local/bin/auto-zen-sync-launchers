#!/usr/bin/env bash
set -euo pipefail

app_id='app.zen_browser.zen'
profile_root="$HOME/.var/app/$app_id/.zen"
profiles_ini="$profile_root/profiles.ini"
applications_dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
launcher_prefix='zen-flatpak-profile-'

profile_name_for_section() {
	local target_section=$1
	local line section=''

	while IFS= read -r line || [[ -n $line ]]; do
		line=${line%$'\r'}
		if [[ $line =~ ^\[([^]]+)\]$ ]]; then
			section=${BASH_REMATCH[1]}
		elif [[ $section == "$target_section" && $line == Name=* ]]; then
			printf '%s\n' "${line#Name=}"
			return 0
		fi
	done < "$profiles_ini"

	return 1
}

if [[ ${1:-} == '--launch' ]]; then
	[[ -f $profiles_ini ]] || { printf 'Zen profiles not found: %s\n' "$profiles_ini" >&2; exit 1; }
	[[ -n ${2:-} ]] || { printf 'Usage: %s --launch PROFILE_SECTION [URL]\n' "${0##*/}" >&2; exit 2; }

	section=$2
	shift 2
	profile_name=$(profile_name_for_section "$section") || {
		printf 'Zen profile section not found: %s\n' "$section" >&2
		exit 1
	}
	exec /usr/bin/flatpak run "$app_id" -P "$profile_name" "$@"
fi

[[ -f $profiles_ini ]] || exit 0
command -v jq >/dev/null || { printf 'Required command not found: jq\n' >&2; exit 1; }
mkdir -p "$applications_dir"

generated=0
skipped=0
section=''
profile_name=''
profile_path=''
is_relative='1'

write_launcher() {
	local launcher profile_dir times_file times_state

	[[ $section == Profile* && -n $profile_name && -n $profile_path ]] || return 0

	if [[ $is_relative == 0 ]]; then
		profile_dir=$profile_path
	else
		profile_dir="$profile_root/$profile_path"
	fi
	times_file="$profile_dir/times.json"
	if [[ -f $times_file ]]; then
		if times_state=$(jq -ser '
			if length != 1 or (.[0] | type) != "object" then error("expected one object")
			elif .[0] | has("firstUse") and .firstUse == null then "unused"
			else "used"
			end
		' "$times_file" 2>/dev/null); then
			if [[ $times_state == unused ]]; then
				((skipped += 1))
				return 0
			fi
		else
			printf 'Ignoring malformed Zen times JSON: %s\n' "$times_file" >&2
		fi
	fi

	launcher="$applications_dir/$launcher_prefix${section,,}.desktop"
	printf '%s\n' \
		'[Desktop Entry]' \
		'Type=Application' \
		"Name=Zen - $profile_name" \
		"Comment=Launch Zen with the $profile_name profile" \
		"Exec=auto-zen-sync-launchers --launch $section %u" \
		'TryExec=auto-zen-sync-launchers' \
		"Icon=$app_id" \
		'Terminal=false' \
		'Categories=Network;WebBrowser;' \
		'StartupNotify=true' \
		'StartupWMClass=zen' \
		"X-Zen-Profile=$section" \
		> "$launcher"
	((generated += 1))
}

rm -f "$applications_dir"/"$launcher_prefix"*.desktop

while IFS= read -r line || [[ -n $line ]]; do
	line=${line%$'\r'}
	if [[ $line =~ ^\[([^]]+)\]$ ]]; then
		new_section=${BASH_REMATCH[1]}
		write_launcher
		section=$new_section
		profile_name=''
		profile_path=''
		is_relative='1'
	elif [[ $section == Profile* ]]; then
		case $line in
			Name=*) profile_name=${line#Name=} ;;
			Path=*) profile_path=${line#Path=} ;;
			IsRelative=*) is_relative=${line#IsRelative=} ;;
		esac
	fi
done < "$profiles_ini"
write_launcher

if command -v update-desktop-database >/dev/null 2>&1; then
	update-desktop-database "$applications_dir" >/dev/null 2>&1 || true
fi

printf 'Generated %d Zen profile launcher(s)' "$generated"
if ((skipped)); then
	printf '; skipped %d unused profile(s)' "$skipped"
fi
printf '\n'
