#!/usr/bin/env bash
set -euo pipefail

app_id='app.zen_browser.zen'
profile_root=${ZEN_PROFILE_ROOT:-"$HOME/.var/app/$app_id/.zen"}
profiles_ini="$profile_root/profiles.ini"
config_dir=${ZEN_CONFIG_DIR:-"${XDG_CONFIG_HOME:-$HOME/.config}/zen"}
style_names=('dotfiles.css' 'taskbar-tabs.css')
import_lines=('@import url("dotfiles.css");' '@import url("taskbar-tabs.css");')
preference_names=(
	'browser.taskbarTabs.enabled'
	'full-screen-api.warning.timeout'
	'toolkit.legacyUserProfileCustomizations.stylesheets'
	'zen.tabs.vertical'
	'zen.tabs.vertical.right-side'
	'zen.view.use-single-toolbar'
	'zen.view.sidebar-expanded'
	'zen.view.compact.enable-at-startup'
	'zen.view.compact.hide-tabbar'
	'zen.view.compact.hide-toolbar'
	'zen.view.compact.show-sidebar-and-toolbar-on-hover'
	'zen.tabs.show-newtab-vertical'
	'zen.view.show-newtab-button-top'
	'zen.urlbar.behavior'
)
preference_values=('true' '0' 'true' 'true' 'true' 'true' 'true' 'false' 'true' 'false' 'false' 'false' 'false' '"float"')
removed_preference_names=('zen.workspaces.show-workspace-indicator' 'browser.download.autohideButton')

[[ -f $profiles_ini ]] || exit 0
command -v jq >/dev/null || { printf 'Required command not found: jq\n' >&2; exit 1; }
for style_name in "${style_names[@]}"; do
	[[ -f $config_dir/$style_name ]] || {
		printf 'Zen stylesheet not found: %s\n' "$config_dir/$style_name" >&2
		exit 1
	}
done

replace_if_changed() {
	local temporary=$1
	local target=$2

	if cmp -s "$temporary" "$target"; then
		rm -f "$temporary"
		return 1
	fi

	chmod 0644 "$temporary"
	mv -f "$temporary" "$target"
}

configure_shortcuts() {
	local target=$1 temporary status has_id=0
	local shortcut_id='dotfiles-open-location-f6'
	local compact_action='cmd_toggleCompactModeIgnoreHover'

	[[ -f $target ]] || return 1
	if ! jq -s -e 'length == 1 and (.[0] | type == "object" and (.shortcuts | type == "array"))' "$target" >/dev/null 2>&1; then
		printf 'Unsupported Zen shortcuts format: %s\n' "$target" >&2
		return 2
	fi

	if jq -e --arg id "$shortcut_id" 'any(.shortcuts[]; .id == $id)' "$target" >/dev/null; then
		has_id=1
	else
		status=$?
		if ((status != 1)); then
			printf 'Unsupported Zen shortcuts format: %s\n' "$target" >&2
			return 2
		fi
	fi

	if ((!has_id)) && jq -e 'any(.shortcuts[]; .keycode == "VK_F6")' "$target" >/dev/null; then
		printf 'F6 is already assigned in %s\n' "$target" >&2
		return 2
	fi

	if ((has_id)); then
		if jq -e --arg action "$compact_action" '
			any(.shortcuts[]; .action == $action and .disabled == false and .reserved == false)
		' "$target" >/dev/null; then
			:
		else
			status=$?
			((status == 1)) && return 1
			printf 'Unsupported Zen shortcuts format: %s\n' "$target" >&2
			return 2
		fi
	fi

	temporary=$(mktemp "$target.tmp.XXXXXX")
	if ! jq --arg id "$shortcut_id" --arg action "$compact_action" '
		.shortcuts |= (
			map(
				if .action == $action and .disabled == false and .reserved == false then
					.reserved = true
				else .
				end
			)
			| if any(.[]; .id == $id) then . else . + [{
				id: $id,
				key: "",
				keycode: "VK_F6",
				group: "pageOperations",
				l10nId: "zen-location-open-shortcut",
				modifiers: {control: false, alt: false, shift: false, meta: false, accel: false},
				action: "Browser:OpenLocation",
				disabled: false,
				reserved: true,
				internal: false
			}] end
		)
	' "$target" > "$temporary"; then
		rm -f "$temporary"
		printf 'Unsupported Zen shortcuts format: %s\n' "$target" >&2
		return 2
	fi
	replace_if_changed "$temporary" "$target"
}

manage_shortcuts=1
if pgrep -x zen >/dev/null 2>&1; then
	manage_shortcuts=0
	printf 'Zen is running; skipping keyboard shortcut configuration\n' >&2
fi

updated=0
unchanged=0
skipped=0
section=''
profile_path=''
is_relative='1'

configure_profile() {
	local profile_dir chrome_dir managed_css user_chrome user_js temporary line trimmed pref import_line style_name
	local shortcuts_file shortcut_status
	local preference_index first_line=1 imports_written=0 managed=0 changed=0

	[[ $section == Profile* && -n $profile_path ]] || return 0

	if [[ $is_relative == 0 ]]; then
		profile_dir=$profile_path
	else
		profile_dir="$profile_root/$profile_path"
	fi

	if [[ ! -d $profile_dir ]]; then
		printf 'Skipping missing Zen profile: %s\n' "$profile_dir" >&2
		((skipped += 1))
		return 0
	fi

	chrome_dir="$profile_dir/chrome"
	user_chrome="$chrome_dir/userChrome.css"
	user_js="$profile_dir/user.js"
	mkdir -p "$chrome_dir"

	for style_name in "${style_names[@]}"; do
		managed_css="$chrome_dir/$style_name"
		temporary=$(mktemp "$managed_css.tmp.XXXXXX")
		install -m 0644 "$config_dir/$style_name" "$temporary"
		if replace_if_changed "$temporary" "$managed_css"; then
			changed=1
		fi
	done

	temporary=$(mktemp "$user_chrome.tmp.XXXXXX")
	{
		if [[ -f $user_chrome ]]; then
			while IFS= read -r line || [[ -n $line ]]; do
				if ((first_line)); then
					first_line=0
					if [[ $line == @charset* ]]; then
						printf '%s\n' "$line"
						printf '%s\n' "${import_lines[@]}"
						imports_written=1
						continue
					fi
					printf '%s\n' "${import_lines[@]}"
					imports_written=1
				fi
				managed=0
				for import_line in "${import_lines[@]}"; do
					if [[ $line == "$import_line" ]]; then
						managed=1
						break
					fi
				done
				((managed)) || printf '%s\n' "$line"
			done < "$user_chrome"
		fi
		((imports_written)) || printf '%s\n' "${import_lines[@]}"
	} > "$temporary"
	if replace_if_changed "$temporary" "$user_chrome"; then
		changed=1
	fi

	temporary=$(mktemp "$user_js.tmp.XXXXXX")
	{
		if [[ -f $user_js ]]; then
			while IFS= read -r line || [[ -n $line ]]; do
				trimmed=${line#"${line%%[![:space:]]*}"}
				managed=0
				for pref in "${preference_names[@]}" "${removed_preference_names[@]}"; do
					if [[ $trimmed == user_pref* && $trimmed == *"\"$pref\""* ]]; then
						managed=1
						break
					fi
				done
				((managed)) && continue
				printf '%s\n' "$line"
			done < "$user_js"
		fi
		for preference_index in "${!preference_names[@]}"; do
			printf 'user_pref("%s", %s);\n' \
				"${preference_names[$preference_index]}" \
				"${preference_values[$preference_index]}"
		done
	} > "$temporary"
	if replace_if_changed "$temporary" "$user_js"; then
		changed=1
	fi

	if ((manage_shortcuts)); then
		shortcuts_file="$profile_dir/zen-keyboard-shortcuts.json"
		if configure_shortcuts "$shortcuts_file"; then
			changed=1
		else
			shortcut_status=$?
			((shortcut_status == 1)) || return "$shortcut_status"
		fi
	fi

	if ((changed)); then
		((updated += 1))
	else
		((unchanged += 1))
	fi
}

while IFS= read -r line || [[ -n $line ]]; do
	line=${line%$'\r'}
	if [[ $line =~ ^\[([^]]+)\]$ ]]; then
		new_section=${BASH_REMATCH[1]}
		configure_profile
		section=$new_section
		profile_path=''
		is_relative='1'
	elif [[ $section == Profile* ]]; then
		case $line in
			Path=*) profile_path=${line#Path=} ;;
			IsRelative=*) is_relative=${line#IsRelative=} ;;
		esac
	fi
done < "$profiles_ini"
configure_profile

printf 'Configured %d Zen profile(s); %d unchanged' "$updated" "$unchanged"
if ((skipped)); then
	printf '; skipped %d missing profile(s)' "$skipped"
fi
printf '\n'
