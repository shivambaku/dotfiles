{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "dotfiles"
  },
  "keybinds": {
    "session.half.page.up": "ctrl+u",
    "session.half.page.down": "ctrl+d"
  },
  "plugins": ["../../Documents/Projects/Personal/opencode-ledger/src"],
  "diffs": {
    "wrap": "word",
    "view": "split",
    "tree": true
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "permissions": "autoaccept",
    "new_location": "inherit",
    "tps": false
  },
  "animations": true,
  "tabs": {
    "enabled": true,
    "scope": "global",
    "layout": "vertical",
    "indicators": "status"
  },
  "terminal": {
    "title": true
  }
}
