{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "lightBase": "#F4F7F8",
    "lightDeep": "#E9EFF2",
    "lightSurface": "#FFFFFF",
    "lightRaised": "#DDE5E9",
    "lightSelection": "#CEDDEA",
    "lightBorder": "#AAB8C2",
    "lightText": "#17212A",
    "lightSecondary": "#43515C",
    "lightMuted": "#6B7882",
    "lightBlue": "#356F9F",
    "lightIce": "#4F7F9F",
    "lightDistantBlue": "#5278A0",
    "lightCyan": "#3F7F87",
    "lightGreen": "#5C7750",
    "lightViolet": "#705D99",
    "lightPeach": "#9A6541",
    "lightWarning": "#8C6A28",
    "lightError": "#A94E57",
    "lightDiffAddedBg": "#DCECDF",
    "lightDiffRemovedBg": "#F2DDE0",
    "darkBase": "#05070A",
    "darkDeep": "#0A0D11",
    "darkSurface": "#13181E",
    "darkRaised": "#1B232B",
    "darkSelection": "#223246",
    "darkBorder": "#3A4652",
    "darkText": "#E1E8EC",
    "darkSecondary": "#B8C3CA",
    "darkMuted": "#7D8992",
    "darkBlue": "#7FB5E5",
    "darkIce": "#A9CCE8",
    "darkDistantBlue": "#6F9FD0",
    "darkCyan": "#78BBC4",
    "darkGreen": "#9CB68E",
    "darkViolet": "#B3A1D6",
    "darkPeach": "#D0A17E",
    "darkWarning": "#D3B26F",
    "darkError": "#D9858B",
    "darkDiffAddedBg": "#162620",
    "darkDiffRemovedBg": "#2B1C23"
  },
  "theme": {
    "primary": { "dark": "darkSelection", "light": "lightSelection" },
    "secondary": { "dark": "darkViolet", "light": "lightViolet" },
    "accent": { "dark": "darkIce", "light": "lightIce" },
    "error": { "dark": "darkError", "light": "lightError" },
    "warning": { "dark": "darkWarning", "light": "lightWarning" },
    "success": { "dark": "darkGreen", "light": "lightGreen" },
    "info": { "dark": "darkCyan", "light": "lightCyan" },
    "text": { "dark": "darkText", "light": "lightText" },
    "textMuted": { "dark": "darkMuted", "light": "lightMuted" },
    "background": {
      "dark": "#05070A00",
      "light": "#F4F7F800"
    },
    "backgroundPanel": { "dark": "darkSurface", "light": "lightSurface" },
    "backgroundElement": { "dark": "darkBase", "light": "lightSurface" },
    "backgroundMenu": { "dark": "darkSurface", "light": "lightSurface" },
    "border": { "dark": "darkBorder", "light": "lightBorder" },
    "borderActive": { "dark": "darkBlue", "light": "lightBlue" },
    "borderSubtle": { "dark": "darkRaised", "light": "lightRaised" },
    "diffAdded": { "dark": "darkGreen", "light": "lightGreen" },
    "diffRemoved": { "dark": "darkError", "light": "lightError" },
    "diffContext": { "dark": "darkMuted", "light": "lightMuted" },
    "diffHunkHeader": { "dark": "darkPeach", "light": "lightPeach" },
    "diffHighlightAdded": { "dark": "darkGreen", "light": "lightGreen" },
    "diffHighlightRemoved": { "dark": "darkError", "light": "lightError" },
    "diffAddedBg": { "dark": "darkDiffAddedBg", "light": "lightDiffAddedBg" },
    "diffRemovedBg": { "dark": "darkDiffRemovedBg", "light": "lightDiffRemovedBg" },
    "diffContextBg": { "dark": "darkDeep", "light": "lightDeep" },
    "diffLineNumber": { "dark": "darkMuted", "light": "lightMuted" },
    "diffAddedLineNumberBg": { "dark": "darkDiffAddedBg", "light": "lightDiffAddedBg" },
    "diffRemovedLineNumberBg": { "dark": "darkDiffRemovedBg", "light": "lightDiffRemovedBg" },
    "markdownText": { "dark": "darkText", "light": "lightText" },
    "markdownHeading": { "dark": "darkViolet", "light": "lightViolet" },
    "markdownLink": { "dark": "darkBlue", "light": "lightBlue" },
    "markdownLinkText": { "dark": "darkIce", "light": "lightIce" },
    "markdownCode": { "dark": "darkGreen", "light": "lightGreen" },
    "markdownBlockQuote": { "dark": "darkWarning", "light": "lightWarning" },
    "markdownEmph": { "dark": "darkWarning", "light": "lightWarning" },
    "markdownStrong": { "dark": "darkPeach", "light": "lightPeach" },
    "markdownHorizontalRule": {
      "dark": "darkSecondary",
      "light": "lightSecondary"
    },
    "markdownListItem": { "dark": "darkBlue", "light": "lightBlue" },
    "markdownListEnumeration": { "dark": "darkIce", "light": "lightIce" },
    "markdownImage": { "dark": "darkBlue", "light": "lightBlue" },
    "markdownImageText": { "dark": "darkIce", "light": "lightIce" },
    "markdownCodeBlock": { "dark": "darkText", "light": "lightText" },
    "syntaxComment": { "dark": "darkMuted", "light": "lightMuted" },
    "syntaxKeyword": { "dark": "darkViolet", "light": "lightViolet" },
    "syntaxFunction": { "dark": "darkBlue", "light": "lightBlue" },
    "syntaxVariable": { "dark": "darkError", "light": "lightError" },
    "syntaxString": { "dark": "darkGreen", "light": "lightGreen" },
    "syntaxNumber": { "dark": "darkPeach", "light": "lightPeach" },
    "syntaxType": { "dark": "darkWarning", "light": "lightWarning" },
    "syntaxOperator": { "dark": "darkCyan", "light": "lightCyan" },
    "syntaxPunctuation": { "dark": "darkText", "light": "lightText" }
  }
}
