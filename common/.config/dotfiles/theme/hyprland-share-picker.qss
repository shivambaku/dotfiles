* {
	font-family: "CommitMono Nerd Font Mono";
	font-size: 14px;
	color: #e1e8ec;
}

QMainWindow,
QMainWindow > QWidget,
QTabWidget::pane,
QScrollArea,
QScrollArea > QWidget > QWidget {
	background-color: #05070a;
}

QTabWidget::pane {
	border: 1px solid #3a4652;
	border-radius: 5px;
	top: -1px;
}

QTabBar::tab {
	background-color: transparent;
	color: #7d8992;
	border: none;
	border-bottom: 2px solid transparent;
	padding: 10px 18px;
	margin-right: 4px;
}

QTabBar::tab:hover {
	color: #e1e8ec;
	background-color: #223246;
}

QTabBar::tab:selected {
	color: #e1e8ec;
	background-color: #223246;
	border-bottom-color: #7fb5e5;
}

QScrollArea {
	border: none;
}

QPushButton {
	background-color: #1b232b;
	color: #7d8992;
	border: 1px solid #3a4652;
	border-radius: 5px;
	padding: 10px 14px;
}

QPushButton:hover,
QPushButton:focus {
	background-color: #223246;
	color: #e1e8ec;
	border-color: #7fb5e5;
}

QPushButton:pressed {
	background-color: #223246;
	color: #e1e8ec;
}

QCheckBox {
	background-color: transparent;
	color: #7d8992;
	border-radius: 5px;
	spacing: 8px;
	padding: 8px 2px 2px 2px;
}

QCheckBox:hover,
QCheckBox:focus {
	background-color: #223246;
	color: #e1e8ec;
}

QAbstractItemView {
	background-color: #05070a;
	color: #7d8992;
	selection-background-color: #223246;
	selection-color: #e1e8ec;
	outline: none;
}

QAbstractItemView::item:hover {
	background-color: #223246;
	color: #e1e8ec;
}

QScrollBar:vertical {
	background-color: transparent;
	width: 8px;
	margin: 2px;
}

QScrollBar::handle:vertical {
	background-color: #223246;
	border-radius: 4px;
	min-height: 30px;
}

QScrollBar::handle:vertical:hover {
	background-color: #3a4652;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
	background: none;
	height: 0;
}

QToolTip {
	background-color: #1b232b;
	color: #e1e8ec;
	border: 1px solid #3a4652;
	padding: 6px;
}
