[delta "dotfiles"]
    navigate = true
	syntax-theme = dotfiles
    paging = never
    dark = true
    tabs = 4

    commit-decoration-style = none 
    file-decoration-style = none

    hunk-header-style = omit
    # hunk-header-decoration-style = ul
	# hunk-header-file-style = bold
	# hunk-header-line-number-style = bold "#B8C3CA"

    plus-style = syntax "#162620"
    plus-emph-style = syntax "#162620"
    minus-style = syntax "#2B1C23"
    minus-emph-style = syntax "#2B1C23"

	blame-palette = "#05070A #0A0D11 #13181E #1B232B #223246"
	file-style = "#E1E8EC"
	map-styles = \
		bold purple => syntax "#1B232B", \
		bold blue => syntax "#223246", \
		bold cyan => syntax "#13181E", \
		bold yellow => syntax "#1B232B"
